{
	"extends": [
		"react-app",
		"react-app/jest",
		"plugin:prettier/recommended"
	],
	"plugins": ["prettier"],
	"rules": {
		"prettier/prettier": "error",
		"no-unsafe-regex": "off"
	},
	"parserOptions": {
		"ecmaVersion": 2020,
		"sourceType": "module"
	},
	"env": {
		"browser": true,
		"es2020": true
	}
}
