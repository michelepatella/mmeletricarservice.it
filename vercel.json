{
	"headers": [
		{
			"source": "/(.*\\.(js|css))",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*\\.(png|avif|svg|pdf|ttf))",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800"
				}
			]
		}
	]
}
